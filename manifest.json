{
  "manifest_version": 3,
  "name": "YouTube Session Timer",
  "version": "1.0.0",
  "description": "Enforce intentional YouTube consumption with session time limits and mandatory cooldowns.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YouTube Session Timer"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-session-timer@abrink0",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}